# Copy this file to .env and fill in your own values. NEVER commit or share the real .env.
# Local test: leave APP_ENV=development. If ADMIN_ACCESS_KEY is empty, a temporary key is printed in the terminal on start.
# Live site: APP_ENV=production needs a strong ADMIN_ACCESS_KEY (12+ chars) and SESSION_SECRET (32+ chars), or the app will refuse to start.
APP_ENV=development
SESSION_SECRET=
ADMIN_ACCESS_KEY=
DATABASE_URL=sqlite:///./riham_demo.db
COOKIE_SECURE=false
STORE_NAME=RIHAM
STORE_THEME=white
CURRENCY=BDT
DELIVERY_FEE=80
FREE_DELIVERY_LIMIT=3000
DHAKA_DELIVERY_FEE=50
OUTSIDE_DELIVERY_FEE=100
# Production example:
# APP_ENV=production
# COOKIE_SECURE=true
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: canonical public domain used by sitemap.xml and robots.txt
PUBLIC_SITE_URL=
