# LOCAL DEVELOPMENT ONLY. Copy to .env and never commit the real .env.
APP_ENV=development
SEED_DEMO_DATA=true
ADMIN_ACCESS_KEY=
SESSION_SECRET=
DATABASE_URL=sqlite:///./riham_demo.db
COOKIE_SECURE=false
STORE_NAME=RIHAM
STORE_THEME=white
CURRENCY=BDT
DELIVERY_FEE=80
FREE_DELIVERY_LIMIT=3000
DHAKA_DELIVERY_FEE=50
OUTSIDE_DELIVERY_FEE=100
PUBLIC_SITE_URL=

# Optional local demo uses ./uploads. Production uploads REQUIRE Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Verify the current base URL and API contract in your Steadfast merchant account.
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Production must use APP_ENV=production, PostgreSQL, an HTTPS PUBLIC_SITE_URL,
# COOKIE_SECURE=true, strong ADMIN_ACCESS_KEY and SESSION_SECRET.
# Example only; replace placeholders with your database provider's connection URL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# APP_ENV=production
# SEED_DEMO_DATA=false
# COOKIE_SECURE=true
# PUBLIC_SITE_URL=https://your-real-domain.example
